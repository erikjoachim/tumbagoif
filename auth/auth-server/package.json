    "drizzle-orm": "0.45.2",
    "hono": "4.12.34",
    "pg": "8.22.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "26.1.2",
    "@types/pg": "8.20.3",
    "drizzle-kit": "0.31.10",
